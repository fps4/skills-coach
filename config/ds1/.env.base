# ds1 deploy configuration — NON-SECRET values only. Committed and reviewed in pull requests.
#
# The one secret (COACH_MONGO_PASSWORD) is appended at deploy time from GitHub Actions secrets;
# see .github/workflows/deploy-ds1.yml. The assembled file is deleted after every deploy.

HOST=ds1
COACH_ENV=production
LOG_LEVEL=info
IMAGE_TAG=dev

# Everything binds to loopback; the shared ds1 reverse proxy fronts the domain and routes `/` to
# the web service. It needs no `/api` rule — the Next server proxies `/api/*` to the api service
# itself (app/api/[...path]/route.ts), because that is what can turn the session cookie into an
# Authorization header.
API_BIND=127.0.0.1
API_PORT=8010
WEB_BIND=127.0.0.1
WEB_PORT=8011
MONGO_BIND=127.0.0.1
MONGO_PORT=27018

MONGO_USER=coach
MONGO_DB=skills-coach
MONGO_AUTH_SOURCE=admin
# The URI deliberately carries no credentials. MONGO_PASSWORD is never written to this file:
# the deploy exports it into the job environment, which compose also interpolates from, so the
# secret takes exactly one path and is never parsed by dotenv.
MONGO_URI=mongodb://mongo:27017

# The api reaches the api service from the web container over the compose network.
API_PROXY_TARGET=http://api:8000
WEB_API_BASE_URL=/api

# Real sign-in via identity-service (ADR-0002). The client must allow the `password` grant and
# carry audience=skills-coach; users are assigned the learner role.
WEB_AUTH_MODE=component-auth
WEB_IDENTITY_BASE_URL=https://auth.fps4.nl
WEB_IDENTITY_CLIENT_ID=skills-coach-web

# Token verification. The JWKS is fetched IN-NETWORK from identity-service (port 7305) — the public
# host is Cloudflare-fronted and unreachable from the api container. Issuer and audience stay the
# public claim values; the fetch URL is independent of them.
AUTH_MODE=jwks
AUTH_JWKS_URL=http://identity-service:7305/.well-known/jwks.json
AUTH_ISSUER=https://auth.fps4.nl
AUTH_AUDIENCE=skills-coach
# The external Docker network the api joins (compose.ds1.networks.yml) to resolve that hostname.
IDENTITY_NETWORK=identity-service_default

# How long audit events are kept before the TTL index removes them.
AUDIT_RETENTION_DAYS=365
