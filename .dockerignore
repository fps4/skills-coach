# Keep the build context small — it is STREAMED to the Docker daemon (the CI runner
# talks to the host socket, so nothing is bind-mounted).
.git
node_modules
**/node_modules
**/dist
**/.next
**/*.tsbuildinfo
.cache
coverage
.env
.env.local
*.md
!README.md
# A skill's guides render in the app (ADR-0029).
!skills/*/guides/*.md
.DS_Store
