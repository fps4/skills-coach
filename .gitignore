# Dependencies
node_modules/

# Build output
dist/
.next/
*.tsbuildinfo

# Environment / secrets — only config/ds1/.env.base is committed
.env
.env.local
config/ds1/.env

# Learner content and artifacts are never committed (see ADR-0006).
# Real packs are imported into MongoDB from a local path; only packs/demo-* ships.
packs/*
!packs/demo-*/
content/

# The wiki is the one committed library — public, impersonal reference guides (ADR-0016). The rule
# above matches a `content/` directory at any depth, so `web/content/` needs the same three-line
# dance the named packs below use: re-include the directory so git walks it, ignore everything in
# it again, then un-ignore the one subdirectory that ships. Last match wins.
!web/content/
web/content/*
!web/content/wiki/

# A pack's MANIFEST is product; its blocks are content (ADR-0008). Granted per pack, by name, so
# the default outcome of dropping a pack into the tree is still that all of it stays out.
#
# Three lines, in this order, because git does not descend into an excluded directory: re-include
# the directory so it is walked, ignore everything inside it again, then un-ignore the one file.
# Last match wins — reordering these silently commits a learner's lessons.
!packs/dutch-conversation-nl/
packs/dutch-conversation-nl/*
!packs/dutch-conversation-nl/pack.yaml

!packs/aws-sap-c02/
packs/aws-sap-c02/*
!packs/aws-sap-c02/pack.yaml

# A reading library is content twice over (ADR-0017): somebody else's articles, kept for one
# learner. The per-pack stanzas above already exclude it — but only while their three lines stay in
# that order, which the comment above warns about. This does not depend on that ordering, and it
# applies to a pack added later whose stanza nobody has written yet.
#
# Keeping a local copy under `packs/<pack>/reading/` is a reasonable thing to want: the loader reads
# that shape directly and is idempotent by slug, so it is what you reload from after a restore. This
# line is what makes keeping it there safe.
packs/*/reading/

# Tooling caches
.cache/
coverage/
.vitest/

# OS
.DS_Store
