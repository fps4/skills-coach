# Dependencies
node_modules/

# Build output
dist/
.next/
*.tsbuildinfo

# Environment / secrets — only config/ds1/.env.base is committed
.env
.env.local
config/ds1/.env

# Learner content and artifacts are never committed (see ADR-0006).
content/

# Skills (ADR-0029): `skills/<id>/skill.yaml` and, beside it, `skills/<id>/guides/*.md` — curated,
# impersonal reference guides that ship with the code and render on the skill's Guides tab. Cards,
# blocks and a local copy of a reading library are content (ADR-0006, ADR-0008) and stay out: dropping a
# skill's whole working directory into the tree still commits only the manifest and the guides.
#
# Order matters: git does not descend into an excluded directory, so the directories themselves are
# re-included, everything inside them is ignored again, and only then are the allowed files
# un-ignored. Last match wins — reordering these silently commits content.
skills/*
!skills/*/
skills/*/*
!skills/*/skill.yaml
!skills/*/guides/
skills/*/guides/*
!skills/*/guides/*.md

# The demo skill is synthetic, invented for this repository, and ships whole — blocks included — so
# the app runs out of the box and CI has a pack to import (ADR-0006).
!skills/demo-*/**

# Tooling caches
.cache/
coverage/
.vitest/

# OS
.DS_Store

# Agent worktrees (Claude Code) — local checkouts, never content of this repository
.claude/worktrees/
