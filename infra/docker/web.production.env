# Build arguments for the published web image (.github/workflows/publish-images.yml).
#
# Next inlines NEXT_PUBLIC_* values into the browser bundle when it builds, so they have to be
# known at build time and every visitor can read them. They are public by construction: nothing
# secret belongs here. They match the WEB_* values in config/ds1/.env.base, which the old in-place
# deploy builds with. When the identity issuer gets a custom domain, both change together.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_AUTH_MODE=component-auth
NEXT_PUBLIC_IDENTITY_BASE_URL=https://wvf40lhrub.execute-api.eu-central-1.amazonaws.com
NEXT_PUBLIC_IDENTITY_CLIENT_ID=skills-coach-web
